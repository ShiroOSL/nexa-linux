<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.nexa.Assistant</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Nexa Assistant</name>
  <summary>Local-first voice assistant for the Linux desktop</summary>

  <description>
    <p>
      Nexa is a local-first voice assistant built for Linux. Say "Hey Nexa"
      and it listens, understands, and talks back — all running on your own
      machine, with speech recognition, wake-word detection, and
      text-to-speech handled locally rather than sent to the cloud.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Always-on "Hey Nexa" wake word with adjustable sensitivity</li>
      <li>Local speech-to-text and natural-sounding text-to-speech</li>
      <li>Weather, jokes, facts, riddles, and system controls</li>
      <li>Nexa Studio: build your own custom voice commands</li>
      <li>Connects to other apps on your system via D-Bus</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.nexa.Assistant.desktop</launchable>

